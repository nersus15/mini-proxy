app:
  name: mini-proxy
  version: 1.0.0
  environment: development

  # features flags
  features:
    recovery: true
    metrics: false
    tracing: false
    profiling: false

  # logging settings
  logging:
    level: debug
    format: "${time} | ${status} | ${latency} | ${ip} | ${method} | ${path} | ${error}\n"
    output: stdout

  # Security settings
  security_headers: true

  # CORS settings
  cors:
    allow_origins:
      - "http://localhost:7272"
      - "http://localhost:8080"
    allow_methods:
      - "GET"
      - "POST"
      - "PUT"
      - "DELETE"
      - "OPTIONS"
    allow_headers:
      - "Origin"
      - "Content-Type"
      - "Accept"
      - "Authorization"
    allow_credentials: true
    expose_headers:
      - "Content-Length"
    max_age: 24h  # 24 hours

  # API rate limiting settings per minute
  rate_limit:
    enabled: true
    limit: 1000
    # burst: 100

  module:
    base_path: "./ext"
    disabled:
      - "modulea"

server:
  host: 0.0.0.0
  port: 2021
  path: "/"
  read_timeout: 30s
  write_timeout: 30s

auth:
  type: none
  # control: RBAC
  # store: db # yaml, db
  # type: jwt # Options: "jwt", "apikey", "basic"
  # secret_key: your-secret-key-here
  # expires_in: 86400 # 24 hours in seconds
  # API Key specific settings (only used when type is "apikey")
  # api_key_header: "X-API-Key"  # Header name for API key
  # api_key_prefix: ""  # Optional prefix for API key validation

database:
  # driver: postgres
  # host: "localhost"
  # port: 6434
  # user: miniproxy
  # password: mini-proxy
  # name: miniproxy
  # schema_name: public
  # ssl_mode: disable
  # max_idle_conns: 5
  # max_open_conns: 10
  # conn_max_lifetime: 60m
  
  # driver: postgres
  # host: "localhost"
  # port: 5432
  # user: miniproxy
  # password: miniproxy 
  # name: miniproxy
  # # schema_name: public
  # ssl_mode: disable
  # max_idle_conns: 5
  # max_open_conns: 10
  # conn_max_lifetime: 60m

  # driver: mysql
  # host: "localhost"
  # port: 3306
  # user: root
  # password:  
  # name: miniproxy
  # # schema_name: public
  # ssl_mode: disable
  # max_idle_conns: 5
  # max_open_conns: 10
  # conn_max_lifetime: 60m

  driver: sqlite
  host: "localhost"
  port: 3306
  user: root
  password:  
  name: ./db/miniproxy.db
  # schema_name: public
  ssl_mode: disable
  max_idle_conns: 5
  max_open_conns: 10
  conn_max_lifetime: 60m
  attributes: 
    _pragma_key: "secret_key"
    _pragma_cipher_page_size: 4096
    _auth:
    _auth_user: "miniproxy"
    _auth_pass: "miniproxy"

  

  # Example slave database configuration
  # slave_hosts:
  #   - host: slave1.example.com
  #     port: 5432
  #     user: konsolidator
  #     password: konsolidator
  #     database: konsolidator
  #     ssl_mode: disable
  #     max_idle_conns: 5
  #     max_open_conns: 50
  #     conn_max_lifetime: 3600

satusehat_dev:
  client_id: <satusehat-clientid>
  authurl: <satusehat-auth-url>
  baseurl: <satusehat-base-url>

satusehat_prod:
  client_id: <satusehat-clientid>
  authurl: <satusehat-auth-url>
  baseurl: <satusehat-base-url>
    

ildki:
  faskes_id: <faskes-id-satusehat>
  enabled: true
  zero_trust: false
  development_url: <ildki-dev-baseurl>
  production_url: <ildki-prod-baseurl>
  development_authurl: <ildki-dev-authurl>
  production_authurl:  <ildki-prod-authurl
  backup_baseurl: <ildki-alternative-domain> //without https

cron:
  enabled: true
  backup_chunksize: 1000
  schedule: "*/10 23 * * *"

# redis:
